# Copie para .env e preencha apenas no seu computador/servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Para testar a Groq localmente, altere AI_PROVIDER para groq.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Necessário para a rota pública; não coloque estes valores no frontend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configuração da rota pública (Vercel). Segredo aleatório de pelo menos 32 caracteres.
AI_COOKIE_SECRET=
AI_ALLOWED_ORIGINS=https://gerador-de-xml-e-cadastro-de-pessoa.vercel.app
AI_VISITOR_MINUTE=4
AI_VISITOR_DAY=20
AI_IP_DAY=60
AI_GLOBAL_DAY=200
