# Copie para .env e preencha apenas no seu computador/servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Para testar a Groq localmente, altere AI_PROVIDER para groq.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Necessário para a rota pública; não coloque estes valores no frontend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configuração da rota pública (Netlify ou Vercel). Segredo aleatório de pelo menos 32 caracteres.
AI_COOKIE_SECRET=
AI_ALLOWED_ORIGINS=https://gerador-all.netlify.app
AI_VISITOR_MINUTE=4
AI_VISITOR_DAY=20
AI_IP_DAY=60
AI_GLOBAL_DAY=200
