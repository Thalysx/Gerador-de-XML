{
  "name": "future-g",
  "version": "3.0.0-alpha.8",
  "private": true,
  "description": "FUTURE G: plataforma de dados sintéticos para desenvolvimento e QA",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "node scripts/serve.cjs",
    "build": "npm run icons:build && node scripts/build.cjs",
    "icons:build": "node scripts/build-icons.cjs",
    "audit:browser": "node scripts/audit-browser.cjs",
    "brand:export": "node scripts/export-brand.cjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "jsdom": "^26.1.0",
    "lucide": "1.44.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.23",
    "@playwright/test": "1.64.1",
    "ws": "^8.21.3"
  }
}
